---
import type { SeriesEntry } from '../utils/series';
import TableOfContents from './TableOfContents.astro';
import { postUrl } from '../lib/publishing/paths.mjs';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  seriesTitle?: string;
  seriesName?: string;
  seriesPosts?: SeriesEntry[];
  currentSlug?: string;
  seriesPath?: string | null;
  collection?: string;
  tags?: string[];
  headings?: Heading[];
}

const { seriesTitle, seriesName, seriesPosts = [], currentSlug, seriesPath, collection, tags = [], headings = [] } = Astro.props;
---

<aside class="hidden lg:block w-full lg:w-64 shrink-0 space-y-4 lg:sticky lg:top-24 lg:self-start">
  <TableOfContents headings={headings} />
  {seriesTitle && seriesPosts.length > 0 && (
    <div class="bg-surface-raised rounded-lg p-5">
      <h3 class="text-xs font-medium uppercase tracking-widest text-foreground-muted mb-3">시리즈</h3>
      {seriesPath ? <a href={seriesPath} class="text-sm font-semibold text-foreground hover:text-accent transition-colors">{seriesTitle}</a> : <p class="text-sm font-semibold">{seriesTitle}</p>}
      <ol class="mt-3 space-y-2">
        {seriesPosts.map((post) => {
          const isCurrent = post.slug === currentSlug;
          return (
            <li>
              <a
                href={postUrl(collection, post)}
                class:list={[
                  'text-xs flex gap-2 transition-colors',
                  isCurrent ? 'text-accent font-medium' : 'text-foreground-muted hover:text-foreground opacity-60 hover:opacity-100',
                ]}
                aria-current={isCurrent ? 'page' : undefined}
              >
                <span class="tabular-nums w-5 shrink-0">{post.data.series?.order}.</span>
                <span class="truncate">{post.data.title}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  )}

  {tags.length > 0 && (
    <div class="bg-surface-raised rounded-lg p-5">
      <h3 class="text-xs font-medium uppercase tracking-widest text-foreground-muted mb-3">태그</h3>
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="text-xs bg-accent-muted text-accent-on-muted px-2 py-0.5 rounded">
            {tag}
          </span>
        ))}
      </div>
    </div>
  )}
</aside>
