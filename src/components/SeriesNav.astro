---
import type { SeriesEntry } from '../utils/series';
import { postUrl } from '../lib/publishing/paths.mjs';

interface Props {
  collection: 'flora' | 'nursery' | 'seeds';
  currentOrder: number;
  currentSlug?: string;
  seriesName: string;
  seriesTitle: string;
  posts: SeriesEntry[];
  seriesPath?: string;
}

const { collection, currentOrder, currentSlug, seriesName, seriesTitle, posts, seriesPath } = Astro.props;
const totalPosts = posts.length;
const position = posts.findIndex(post => currentSlug ? post.slug === currentSlug : post.data.series?.order === currentOrder) + 1;
---

<aside
  class="border-l-4 border-accent rounded-r-xl p-4 mb-8 bg-gradient-to-r from-accent-muted/10 to-transparent"
  aria-labelledby={`series-${seriesName}`}
>
  <div class="mb-3">
    <p class="text-xs uppercase tracking-widest text-foreground-muted mb-1">시리즈</p>
    <h2 id={`series-${seriesName}`} class="text-base font-semibold">
      {seriesPath ? (
        <a href={seriesPath} class="text-foreground hover:text-accent transition-colors">{seriesTitle}</a>
      ) : seriesTitle}
      <span class="ml-2 text-accent font-normal">({position}/{totalPosts})</span>
    </h2>
  </div>

  <details>
    <summary class="text-sm font-semibold cursor-pointer hover:text-accent transition-colors">
      시리즈 전체 보기
    </summary>
    <ol class="mt-3 space-y-2 list-none pl-0">
      {posts.map((post) => {
        const isCurrent = currentSlug ? post.slug === currentSlug : post.data.series?.order === currentOrder;
        const postHref = postUrl(collection, post);
        return (
          <li>
            <a
              href={postHref}
              class:list={[
                'text-sm flex gap-2 transition-colors',
                isCurrent
                  ? 'text-accent font-semibold'
                  : 'text-foreground-muted/70 hover:text-foreground hover:opacity-100',
              ]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span class="tabular-nums w-6 shrink-0">{post.data.series?.order}.</span>
              <span>{post.data.title}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </details>
</aside>
