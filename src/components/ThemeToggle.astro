---
---
<div id="theme-popover-wrapper" class="relative">
  <button id="theme-toggle" class="theme-trigger" aria-label="테마 변경" aria-haspopup="true" aria-expanded="false">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    <span>Theme</span>
  </button>

  <div id="theme-popover" class="theme-popover curated-theme-popover" role="menu" aria-label="테마 선택">
    <div class="picker-section">
      <div class="picker-label">Theme</div>
      <div class="curated-theme-grid">
        <button data-set-visual-theme="garden" class="curated-theme-option" role="menuitem"><i class="theme-preview garden"></i><span><strong>Garden</strong><small>Sunlit leaves</small></span></button>
        <button data-set-visual-theme="rain" class="curated-theme-option" role="menuitem"><i class="theme-preview rain"></i><span><strong>Rain</strong><small>Quiet rainfall</small></span></button>
        <button data-set-visual-theme="moonlight" class="curated-theme-option" role="menuitem"><i class="theme-preview moonlight"></i><span><strong>Moonlight</strong><small>Night garden</small></span></button>
        <button data-set-visual-theme="dawn" class="curated-theme-option" role="menuitem"><i class="theme-preview dawn"></i><span><strong>Dawn</strong><small>Warm moving light</small></span></button>
        <button data-set-visual-theme="aurora" class="curated-theme-option" role="menuitem"><i class="theme-preview aurora"></i><span><strong>Aurora</strong><small>Slow northern glow</small></span></button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const THEMES = {
      garden: { style: 'garden', atmosphere: 'sunny', brightness: 'light' },
      rain: { style: 'garden', atmosphere: 'rain', brightness: 'light', video: '/videos/rain.mp4' },
      moonlight: { style: 'twilight', atmosphere: 'moonlight', brightness: 'dark', video: '/videos/moon.mp4' },
      dawn: { style: 'terracotta', atmosphere: 'dawn', brightness: 'light' },
      aurora: { style: 'twilight', atmosphere: 'aurora', brightness: 'dark' },
    };
    let listenersAttached = false;

    function legacyTheme() {
      const atmo = localStorage.getItem('atmosphere');
      if (atmo === 'rain' || atmo === 'moonlight' || atmo === 'dawn' || atmo === 'aurora') return atmo;
      return localStorage.getItem('style') === 'twilight' ? 'moonlight' : 'garden';
    }

    function init() {
      const button = document.getElementById('theme-toggle');
      const popover = document.getElementById('theme-popover');
      const wrapper = document.getElementById('theme-popover-wrapper');
      if (!button || !popover || !wrapper || button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      let isOpen = false;
      const getTheme = () => localStorage.getItem('visualTheme') || legacyTheme();

      function loadVideo(theme) {
        const video = document.getElementById('atmosphere-video');
        if (!video) return;
        const src = THEMES[theme].video;
        if (!src) { video.removeAttribute('src'); video.load(); return; }
        if (video.getAttribute('src') !== src) { video.src = src; video.load(); }
        video.play().catch(() => {});
      }

      function apply() {
        const theme = THEMES[getTheme()] ? getTheme() : 'garden';
        const config = THEMES[theme];
        localStorage.setItem('visualTheme', theme);
        document.documentElement.dataset.style = config.style;
        document.documentElement.dataset.atmosphere = config.atmosphere;
        document.documentElement.dataset.theme = config.brightness;
        document.documentElement.dataset.visualMotion = 'on';
        document.documentElement.style.colorScheme = config.brightness;
        const meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', config.brightness === 'dark' ? '#10141d' : '#faf9f6');
        document.querySelectorAll('[data-set-visual-theme]').forEach((el) => el.classList.toggle('is-active', el.dataset.setVisualTheme === theme));
        loadVideo(theme);
      }

      function close() { popover.classList.remove('is-open'); button.setAttribute('aria-expanded', 'false'); isOpen = false; }
      button.addEventListener('click', (event) => { event.stopPropagation(); isOpen ? close() : (popover.classList.add('is-open'), button.setAttribute('aria-expanded', 'true'), isOpen = true); });
      document.querySelectorAll('[data-set-visual-theme]').forEach((el) => el.addEventListener('click', () => { localStorage.setItem('visualTheme', el.dataset.setVisualTheme); apply(); close(); }));

      if (!listenersAttached) {
        listenersAttached = true;
        document.addEventListener('click', (event) => { const current = document.getElementById('theme-popover-wrapper'); if (isOpen && current && !current.contains(event.target)) close(); });
        document.addEventListener('visibilitychange', () => { const video = document.getElementById('atmosphere-video'); if (!video?.src) return; document.hidden ? video.pause() : video.play().catch(() => {}); });
      }
      apply();
    }
    document.addEventListener('astro:page-load', init);
    document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init) : init();
  })();
</script>
