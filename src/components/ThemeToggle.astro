<details id="theme-picker" class="theme-picker">
  <summary aria-label="테마 변경" title="테마 변경">
    <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
    <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
  </summary>
  <fieldset>
    <legend class="sr-only">화면 테마</legend>
    <label><input type="radio" name="reading-theme" value="light" />밝게</label>
    <label><input type="radio" name="reading-theme" value="dark" />어둡게</label>
    <label><input type="radio" name="reading-theme" value="system" checked />시스템 설정</label>
  </fieldset>
</details>
<style>
  .theme-picker { position: relative; }
  summary { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; list-style: none; color: var(--color-foreground-muted); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--color-foreground); }
  .theme-moon { display: none; }
  :global([data-theme="dark"]) .theme-sun { display: none; }
  :global([data-theme="dark"]) .theme-moon { display: block; }
  fieldset { position: absolute; z-index: 100; top: calc(100% + .4rem); right: 0; width: 10.5rem; padding: .35rem; border: 1px solid var(--color-outline-subtle); border-radius: 6px; background: var(--color-surface); box-shadow: 0 4px 16px rgb(0 0 0 / .08); }
  label { display: flex; align-items: center; gap: .7rem; min-height: 44px; padding: .4rem .65rem; font-size: .85rem; cursor: pointer; }
  label:hover { background: var(--color-surface-raised); }
  input { accent-color: var(--color-foreground); }
  @media (max-width: 767px) { fieldset { right: -44px; } }
</style>
