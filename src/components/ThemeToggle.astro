---
---
<div id="theme-popover-wrapper" class="relative">
  <button id="theme-toggle" class="theme-trigger" aria-label="테마와 분위기 설정" aria-haspopup="true" aria-expanded="false">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    <span>Style</span>
  </button>

  <div id="theme-popover" class="theme-popover" role="menu" aria-label="테마와 분위기 설정">
    <div class="picker-section">
      <div class="picker-label">Palette</div>
      <div class="palette-grid">
        <button data-set-style="garden" class="palette-option" role="menuitem"><i class="palette-swatch garden"></i><span>Garden</span></button>
        <button data-set-style="paper" class="palette-option" role="menuitem"><i class="palette-swatch paper"></i><span>Paper</span></button>
        <button data-set-style="twilight" class="palette-option" role="menuitem"><i class="palette-swatch twilight"></i><span>Twilight</span></button>
        <button data-set-style="terracotta" class="palette-option" role="menuitem"><i class="palette-swatch terracotta"></i><span>Terracotta</span></button>
      </div>
    </div>

    <div class="picker-section picker-divider">
      <div class="picker-label">Brightness</div>
      <div class="mode-row">
        <button data-set-theme="light" class="mode-option" role="menuitem">Light</button>
        <button data-set-theme="dark" class="mode-option" role="menuitem">Dark</button>
        <button data-set-theme="system" class="mode-option" role="menuitem">System</button>
      </div>
    </div>

    <div class="picker-section picker-divider">
      <div class="flex items-center justify-between mb-2"><div class="picker-label !mb-0">Atmosphere</div><span id="atmo-hint" class="atmo-hint"></span></div>
      <div class="atmo-grid">
        <button data-set-atmo="none" class="atmo-option" role="menuitem"><span class="atmo-dot none"></span>None</button>
        <button data-set-atmo="sunny" class="atmo-option" role="menuitem"><span class="atmo-dot sunny"></span>Sunny</button>
        <button data-set-atmo="dawn" class="atmo-option" role="menuitem"><span class="atmo-dot dawn"></span>Dawn</button>
        <button data-set-atmo="rain" class="atmo-option" role="menuitem"><span class="atmo-dot rain"></span>Rain</button>
        <button data-set-atmo="moonlight" class="atmo-option" role="menuitem"><span class="atmo-dot moonlight"></span>Moonlight</button>
        <button data-set-atmo="aurora" class="atmo-option" role="menuitem"><span class="atmo-dot aurora"></span>Aurora</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const VIDEO_MAP = { sunny: '/videos/leaves.mp4', moonlight: '/videos/moon.mp4', rain: '/videos/rain.mp4' };
    const COMPATIBLE_ATMOSPHERES = {
      garden: ['none', 'sunny', 'dawn', 'rain'],
      paper: ['none', 'sunny', 'dawn'],
      twilight: ['none', 'moonlight', 'rain', 'aurora'],
      terracotta: ['none', 'sunny', 'dawn', 'moonlight'],
    };
    let listenersAttached = false;

    function init() {
      const btn = document.getElementById('theme-toggle');
      const popover = document.getElementById('theme-popover');
      const wrapper = document.getElementById('theme-popover-wrapper');
      if (!btn || !popover || !wrapper || btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let isOpen = false;

      const getTheme = () => localStorage.getItem('theme') || 'system';
      const getStyle = () => localStorage.getItem('style') || 'garden';
      const getAtmo = () => localStorage.getItem('atmosphere') || 'none';
      const resolveTheme = (theme) => theme === 'system' ? (prefersDark.matches ? 'dark' : 'light') : theme;
      const resolveColorScheme = (style, atmo) => style === 'twilight' || atmo === 'aurora' ? 'dark' : resolveTheme(getTheme());
      const compatible = (style, atmo) => COMPATIBLE_ATMOSPHERES[style].includes(atmo);

      function loadVideo(atmo) {
        const video = document.getElementById('atmosphere-video');
        if (!video) return;
        const blocked = navigator.connection && navigator.connection.saveData || prefersReducedMotion.matches;
        const src = !blocked && VIDEO_MAP[atmo];
        if (!src) { video.removeAttribute('src'); video.load(); return; }
        if (video.getAttribute('src') !== src) { video.src = src; video.load(); video.play().catch(() => {}); }
      }

      function updateControls() {
        const theme = getTheme(); const style = getStyle(); const atmo = getAtmo();
        document.querySelectorAll('[data-set-theme]').forEach((el) => el.classList.toggle('is-active', el.dataset.setTheme === theme));
        document.querySelectorAll('[data-set-style]').forEach((el) => el.classList.toggle('is-active', el.dataset.setStyle === style));
        document.querySelectorAll('[data-set-atmo]').forEach((el) => {
          const allowed = compatible(style, el.dataset.setAtmo);
          el.disabled = !allowed;
          el.classList.toggle('is-disabled', !allowed);
          el.classList.toggle('is-active', allowed && el.dataset.setAtmo === atmo);
        });
        const hint = document.getElementById('atmo-hint');
        if (hint) hint.textContent = atmo === 'none' ? 'Palette matched' : `${style} × ${atmo}`;
      }

      function apply() {
        const style = getStyle();
        let atmo = getAtmo();
        if (!compatible(style, atmo)) { atmo = 'none'; localStorage.setItem('atmosphere', atmo); }
        const colorScheme = resolveColorScheme(style, atmo);
        document.documentElement.dataset.theme = resolveTheme(getTheme());
        document.documentElement.dataset.style = style;
        document.documentElement.dataset.atmosphere = atmo;
        document.documentElement.style.colorScheme = colorScheme;
        const meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', colorScheme === 'dark' ? '#10141d' : '#faf9f6');
        loadVideo(atmo); updateControls();
      }
      function close() { popover.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); isOpen = false; }
      function set(key, value) { localStorage.setItem(key, value); apply(); }

      btn.addEventListener('click', (event) => { event.stopPropagation(); isOpen ? close() : (popover.classList.add('is-open'), btn.setAttribute('aria-expanded', 'true'), isOpen = true); });
      document.querySelectorAll('[data-set-theme]').forEach((el) => el.addEventListener('click', () => set('theme', el.dataset.setTheme)));
      document.querySelectorAll('[data-set-style]').forEach((el) => el.addEventListener('click', () => set('style', el.dataset.setStyle)));
      document.querySelectorAll('[data-set-atmo]').forEach((el) => el.addEventListener('click', () => { if (!el.disabled) set('atmosphere', el.dataset.setAtmo); }));

      if (!listenersAttached) {
        listenersAttached = true;
        document.addEventListener('click', (event) => { const current = document.getElementById('theme-popover-wrapper'); if (isOpen && current && !current.contains(event.target)) close(); });
        document.addEventListener('visibilitychange', () => { const video = document.getElementById('atmosphere-video'); if (!video?.src) return; document.hidden ? video.pause() : video.play().catch(() => {}); });
        prefersDark.addEventListener('change', () => { if (getTheme() === 'system') apply(); });
      }
      apply();
    }
    document.addEventListener('astro:page-load', init);
    document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init) : init();
  })();
</script>
