---
import Layout from "../layouts/Layout.astro";
import { PAGE_DESCRIPTIONS } from "../consts/site";
import { TOPICS, topicFor } from "../consts/topics";
import { getAllPosts } from "../utils/posts";

const allPosts = await getAllPosts();
const featured = allPosts[0];
const recentPosts = allPosts.slice(1, 4);
const topicLinks = Object.entries(TOPICS).filter(([key]) => key !== 'notes');
---

<Layout title="The Greenhouse" description={PAGE_DESCRIPTIONS.home} canonicalPath="/">
  <main class="journal-home">
    <header class="journal-masthead">
      <p>A PERSONAL JOURNAL</p>
      <a href="/" aria-label="The Greenhouse home">The Greenhouse</a>
      <span>SEOUL · EST. 2026</span>
    </header>

    <nav class="journal-sections" aria-label="글 주제">
      {topicLinks.map(([key, topic]) => <a href={`/topics/${key}/`}>{topic.label}</a>)}
      <a href="/topics/notes/">기록</a>
    </nav>

    {featured && <article class="lead-story">
      <a href={featured.url} class="lead-image" aria-label={featured.data.title}>
        <img src="/img/greenhouse-home-hero.png" alt="햇살이 드는 창가의 나무 테이블과 노트" />
      </a>
      <div class="lead-copy">
        <p class="story-kicker">{TOPICS[topicFor(featured.data.category)].label} · FEATURED</p>
        <h1><a href={featured.url}>{featured.data.title}</a></h1>
        {featured.data.summary && <p class="lead-summary">{featured.data.summary}</p>}
        <a href={featured.url} class="read-more">읽어보기 <span>→</span></a>
      </div>
    </article>}

    <section class="recent-notes" aria-labelledby="recent-heading">
      <div class="section-rule"><p>RECENT NOTES</p><span></span><a href="/topics/notes/">모든 글 보기 →</a></div>
      <div class="note-grid">
        {recentPosts.map((post) => {
          const topic = TOPICS[topicFor(post.data.category)];
          return <article class="note-item">
            <p>{topic.label} <span>·</span> {post.data.date.toISOString().slice(0, 10)}</p>
            <h2><a href={post.url}>{post.data.title}</a></h2>
            {post.data.summary && <p class="note-summary">{post.data.summary}</p>}
            <a class="note-link" href={post.url}>Read note →</a>
          </article>;
        })}
      </div>
    </section>

    <section class="topic-directory" aria-labelledby="directory-heading">
      <p class="story-kicker">EXPLORE THE JOURNAL</p>
      <h2 id="directory-heading">관심 가는 이야기를<br />천천히 골라보세요.</h2>
      <div class="directory-links">
        {Object.entries(TOPICS).map(([key, topic]) => <a href={`/topics/${key}/`}><span>{topic.label}</span><small>{topic.description}</small><b>↗</b></a>)}
      </div>
    </section>
  </main>
</Layout>

<style>
  .journal-home { width: min(100% - 2.5rem, 72rem); margin: 0 auto; padding: 2.5rem 0 7rem; }
  .journal-masthead { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 1.8rem 0 1.5rem; border-bottom: 1px solid var(--color-outline-subtle); text-align: center; }
  .journal-masthead p, .journal-masthead span { font-size: .61rem; font-weight: 700; letter-spacing: .14em; color: var(--color-foreground-muted); } .journal-masthead span { text-align: right; } .journal-masthead p { text-align: left; } .journal-masthead > a { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1; letter-spacing: -.07em; }
  .journal-sections { display: flex; justify-content: center; gap: clamp(1.1rem, 4vw, 3.4rem); padding: .8rem 0; border-bottom: 1px solid var(--color-outline-subtle); } .journal-sections a { font-size: .72rem; font-weight: 700; letter-spacing: .08em; color: var(--color-foreground-muted); transition: color .18s ease; } .journal-sections a:hover { color: var(--color-foreground); }
  .lead-story { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(17rem, .85fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding: 4rem 0 5rem; border-bottom: 1px solid var(--color-outline-subtle); } .lead-image { display: block; overflow: hidden; background: var(--color-surface-raised); aspect-ratio: 1.34; } .lead-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.7,.2,1); } .lead-story:hover .lead-image img { transform: scale(1.035); }
  .story-kicker { margin-bottom: .85rem; font-size: .65rem; font-weight: 700; letter-spacing: .16em; color: var(--color-foreground-muted); } .lead-copy h1 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.3rem, 4.5vw, 4.2rem); font-weight: 400; line-height: .98; letter-spacing: -.065em; } .lead-summary { margin-top: 1.2rem; color: var(--color-foreground-muted); font-size: .95rem; line-height: 1.8; } .read-more { display: inline-flex; gap: .75rem; margin-top: 1.7rem; padding-bottom: .25rem; border-bottom: 1px solid var(--color-foreground); font-size: .75rem; font-weight: 700; letter-spacing: .06em; } .read-more span { transition: transform .2s ease; } .lead-story:hover .read-more span { transform: translateX(.25rem); }
  .recent-notes { padding: 4.5rem 0; border-bottom: 1px solid var(--color-outline-subtle); } .section-rule { display: flex; align-items: center; gap: 1rem; margin-bottom: 2.4rem; } .section-rule p, .section-rule a { font-size: .64rem; font-weight: 700; letter-spacing: .14em; white-space: nowrap; } .section-rule p { color: var(--color-foreground-muted); } .section-rule span { height: 1px; flex: 1; background: var(--color-outline-subtle); } .section-rule a { transition: opacity .2s ease; } .section-rule a:hover { opacity: .6; }
  .note-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); } .note-item { min-width: 0; } .note-item > p:first-child { font-size: .65rem; font-weight: 700; letter-spacing: .09em; color: var(--color-foreground-muted); } .note-item > p:first-child span { padding: 0 .25rem; } .note-item h2 { margin: .7rem 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.5rem, 2.4vw, 2.1rem); font-weight: 400; line-height: 1.08; letter-spacing: -.045em; } .note-summary { color: var(--color-foreground-muted); font-size: .84rem; line-height: 1.7; } .note-link { display: inline-block; margin-top: 1.1rem; font-size: .67rem; font-weight: 700; letter-spacing: .08em; }
  .topic-directory { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; padding: 6rem 0 1rem; } .topic-directory > h2 { grid-column: 1; margin: 0; align-self: start; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 400; line-height: 1.02; letter-spacing: -.065em; } .topic-directory > .story-kicker { grid-column: 1 / -1; margin: 0; } .directory-links { grid-column: 2; grid-row: 2; border-top: 1px solid var(--color-outline-subtle); } .directory-links a { display: grid; grid-template-columns: 5rem 1fr auto; align-items: baseline; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-outline-subtle); } .directory-links a:hover span { padding-left: .35rem; } .directory-links span { font-family: Georgia, 'Times New Roman', serif; font-size: 1.55rem; letter-spacing: -.04em; transition: padding .2s ease; } .directory-links small { color: var(--color-foreground-muted); font-size: .72rem; } .directory-links b { font-size: .9rem; font-weight: 400; }
  @media (max-width: 720px) { .journal-home { width: min(100% - 2rem, 72rem); padding-top: 1rem; } .journal-masthead { grid-template-columns: 1fr; gap: .6rem; } .journal-masthead p, .journal-masthead span { display: none; } .journal-sections { justify-content: flex-start; overflow-x: auto; gap: 1.5rem; } .journal-sections a { white-space: nowrap; } .lead-story { grid-template-columns: 1fr; padding: 2.5rem 0 3.5rem; gap: 1.8rem; } .lead-image { aspect-ratio: 1.12; } .note-grid { grid-template-columns: 1fr; gap: 2.5rem; } .topic-directory { grid-template-columns: 1fr; gap: 2rem; padding-top: 4rem; } .topic-directory > h2, .topic-directory > .story-kicker, .directory-links { grid-column: auto; grid-row: auto; } }
</style>
