---
import Layout from "../layouts/Layout.astro";
import { PAGE_DESCRIPTIONS } from "../consts/site";
import { TOPICS, topicFor } from "../consts/topics";
import { getAllPosts } from "../utils/posts";

const allPosts = await getAllPosts();
const topics = Object.entries(TOPICS).map(([key, topic]) => ({
  key,
  ...topic,
  count: allPosts.filter((post) => topicFor(post.data.category) === key).length,
}));
const featured = allPosts[0];
---

<Layout title="The Greenhouse" description={PAGE_DESCRIPTIONS.home} canonicalPath="/">
  <main class="magazine-shell">
    <section class="magazine-hero">
      <div class="hero-orb hero-orb--one"></div><div class="hero-orb hero-orb--two"></div>
      <p class="eyebrow">PERSONAL MAGAZINE · SEOUL</p>
      <h1>The Greenhouse</h1>
      <p class="hero-copy">요리하고, 듣고, 떠나고, 만들며 남기는<br class="hidden sm:block" /> 다채로운 생활의 기록.</p>
      <a class="hero-link" href="#latest">최근 글 보기 <span aria-hidden="true">↓</span></a>
    </section>

    <section class="topic-section" aria-labelledby="topics-heading">
      <div class="section-heading"><p class="eyebrow">EXPLORE BY MOOD</p><h2 id="topics-heading">오늘은 어떤 이야기를 볼까요?</h2></div>
      <div class="topic-index">
        {topics.map((topic, index) => (
          <a href={`/topics/${topic.key}/`} class={`topic-row topic-row--${topic.key}`}>
            <span class="topic-number">0{index + 1}</span><h3>{topic.label}</h3><p>{topic.description}</p><span class="topic-count">{topic.count} posts</span><span class="topic-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    {featured && <section class="featured-section" aria-labelledby="featured-heading">
      <p class="eyebrow">FEATURED NOTE</p>
      <a href={featured.url} class={`featured-story featured-story--${topicFor(featured.data.category)}`}>
        <div><span class="featured-topic">{TOPICS[topicFor(featured.data.category)].label}</span><h2 id="featured-heading">{featured.data.title}</h2>{featured.data.summary && <p>{featured.data.summary}</p>}<span class="read-link">읽어보기 →</span></div>
        <time datetime={featured.data.date.toISOString()}>{featured.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      </a>
    </section>}

    <section class="latest-section" id="latest" aria-labelledby="latest-heading">
      <div class="section-heading section-heading--row"><div><p class="eyebrow">FRESH FROM THE DESK</p><h2 id="latest-heading">최근 기록</h2></div><a href="/topics/notes/" class="all-link">모든 기록 →</a></div>
      <div class="latest-list">
        {allPosts.slice(0, 10).map((post) => {
          const topic = TOPICS[topicFor(post.data.category)];
          return <a href={post.url} class="latest-row"><span class="latest-topic">{topic.label}</span><span class="latest-title">{post.data.title}</span><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time></a>;
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
  .magazine-shell { max-width: 72rem; margin: 0 auto; padding: 2.25rem 1.5rem 6rem; }
  .magazine-hero { position: relative; overflow: hidden; min-height: 31rem; border-radius: 2rem; padding: clamp(2.5rem, 8vw, 6.5rem); display: flex; flex-direction: column; justify-content: flex-end; color: #fffaf2; background: linear-gradient(135deg, #182e28 0%, #2f6958 45%, #e77e59 130%); isolation: isolate; }
  .magazine-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; opacity: .48; background: repeating-linear-gradient(115deg, transparent 0 5rem, rgba(255,255,255,.08) 5.1rem 5.2rem, transparent 5.3rem 9rem); animation: drift-lines 18s linear infinite; }
  .hero-orb { position: absolute; border-radius: 999px; filter: blur(2px); opacity: .72; z-index: -1; animation: float-orb 10s ease-in-out infinite alternate; } .hero-orb--one { width: 22rem; height: 22rem; top: -7rem; right: -3rem; background: #fedb77; } .hero-orb--two { width: 16rem; height: 16rem; bottom: -8rem; left: 26%; background: #ff9075; animation-delay: -5s; }
  .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .18em; color: inherit; opacity: .72; } .magazine-hero h1 { margin: .75rem 0 1rem; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(3.8rem, 10vw, 7.5rem); font-weight: 400; letter-spacing: -.075em; line-height: .85; } .hero-copy { max-width: 34rem; font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.65; } .hero-link, .all-link, .read-link { margin-top: 2rem; width: fit-content; font-size: .83rem; font-weight: 700; letter-spacing: .04em; } .hero-link span { display: inline-block; margin-left: .4rem; animation: bounce-arrow 1.6s ease-in-out infinite; }
  .topic-section, .featured-section, .latest-section { margin-top: 7rem; } .section-heading { margin-bottom: 1.75rem; } .section-heading .eyebrow, .featured-section > .eyebrow { color: var(--color-foreground-muted); } .section-heading h2 { margin-top: .55rem; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.85rem, 3.5vw, 2.65rem); line-height: 1.1; letter-spacing: -.045em; } .section-heading--row { display: flex; align-items: end; justify-content: space-between; gap: 1rem; } .all-link { margin: 0; color: var(--color-foreground-muted); white-space: nowrap; }
  .topic-index { border-top: 1px solid var(--color-outline-subtle); } .topic-row { position: relative; display: grid; grid-template-columns: 3.5rem minmax(7rem, .8fr) 1.2fr auto 1.5rem; gap: 1.2rem; align-items: center; min-height: 6.75rem; padding: .8rem .15rem; border-bottom: 1px solid var(--color-outline-subtle); overflow: hidden; transition: color .28s ease, padding .28s ease; } .topic-row::before { content: ''; position: absolute; z-index: -1; inset: 0 100% 0 0; transition: inset .42s cubic-bezier(.2,.8,.2,1); } .topic-row:hover { padding-left: 1.05rem; color: #142019; } .topic-row:hover::before { inset: 0; } .topic-row h3 { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; letter-spacing: -.07em; line-height: 1; } .topic-row p, .topic-count, .topic-number { font-size: .76rem; line-height: 1.45; color: var(--color-foreground-muted); transition: color .28s ease; } .topic-row:hover p, .topic-row:hover .topic-count, .topic-row:hover .topic-number { color: inherit; opacity: .68; } .topic-count { font-family: monospace; font-size: .68rem; text-transform: uppercase; white-space: nowrap; } .topic-number { font-family: monospace; } .topic-arrow { font-size: 1.2rem; text-align: right; transform: translate(-.35rem, .35rem); opacity: 0; transition: transform .28s ease, opacity .28s ease; } .topic-row:hover .topic-arrow { transform: translate(0); opacity: 1; }
  .topic-row--life::before { background: #f2bd80; } .topic-row--food::before { background: #ef947b; } .topic-row--music::before { background: #c7addd; } .topic-row--travel::before { background: #8dc8bf; } .topic-row--tech::before { background: #a7c7ef; } .topic-row--notes::before { background: #d7d29b; }
  .featured-story { position: relative; min-height: 22rem; padding: clamp(2rem, 5vw, 4.5rem) 0; display: flex; justify-content: space-between; gap: 2rem; overflow: hidden; border-top: 2px solid var(--color-foreground); border-bottom: 1px solid var(--color-outline-subtle); transition: padding .3s ease; } .featured-story::before { content: ''; position: absolute; z-index: -1; width: 48%; height: 100%; right: 0; top: 0; opacity: .72; transform: translateX(70%); transition: transform .55s cubic-bezier(.2,.8,.2,1); } .featured-story:hover { padding-left: 1.25rem; } .featured-story:hover::before { transform: translateX(0); } .featured-story > div, .featured-story time { position: relative; z-index: 1; } .featured-story h2 { max-width: 45rem; margin: .85rem 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.1rem, 5vw, 4.5rem); font-weight: 400; line-height: 1.04; letter-spacing: -.06em; } .featured-story p { max-width: 38rem; color: var(--color-foreground-muted); line-height: 1.7; } .featured-topic { font-size: .72rem; font-weight: 700; letter-spacing: .08em; } .featured-story time { align-self: flex-end; font-family: monospace; font-size: .72rem; white-space: nowrap; color: var(--color-foreground-muted); } .featured-story--life::before { background: #f2bd80; } .featured-story--food::before { background: #ef947b; } .featured-story--music::before { background: #c7addd; } .featured-story--travel::before { background: #8dc8bf; } .featured-story--tech::before { background: #a7c7ef; } .featured-story--notes::before { background: #d7d29b; }
  .latest-list { border-top: 1px solid var(--color-outline-subtle); } .latest-row { display: grid; grid-template-columns: 5rem 1fr auto; gap: 1rem; align-items: center; padding: 1.1rem .25rem; border-bottom: 1px solid var(--color-outline-subtle); transition: padding .25s ease, background .25s ease; } .latest-row:hover { padding-left: .7rem; background: var(--color-surface-raised); } .latest-topic { font-size: .72rem; color: var(--color-foreground-muted); } .latest-title { font-size: .98rem; font-weight: 600; } .latest-row time { font-family: monospace; font-size: .7rem; color: var(--color-foreground-muted); }
  @keyframes drift-lines { to { transform: translateX(-9rem); } } @keyframes float-orb { to { transform: translate3d(-1.5rem, 2rem, 0) scale(1.12); } } @keyframes bounce-arrow { 50% { transform: translateY(.3rem); } }
  @media (max-width: 700px) { .magazine-shell { padding-top: 1.25rem; } .magazine-hero { min-height: 27rem; border-radius: 1.4rem; } .topic-row { grid-template-columns: 2rem 1fr auto; gap: .7rem; min-height: 5.4rem; } .topic-row p, .topic-count { display: none; } .topic-row h3 { font-size: 2.25rem; } .topic-arrow { opacity: .7; transform: none; } .featured-story { min-height: 18rem; } .featured-story time { display: none; } .featured-story::before { width: 70%; } .latest-row { grid-template-columns: 3.4rem 1fr; } .latest-row time { display: none; } }
</style>
