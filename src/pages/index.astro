---
import Layout from "../layouts/Layout.astro";
import SectionCard from "../components/SectionCard.astro";
import { getCollection } from "astro:content";
import { PAGE_DESCRIPTIONS } from "../consts/site";
import { SECTION_INDEX_CONFIG, filterPublished } from "../consts/sections";
import { getAllPosts } from "../utils/posts";

const [allFlora, allNursery, allSeeds] = await Promise.all([
    getCollection("flora").then(filterPublished),
    getCollection("nursery").then(filterPublished),
    getCollection("seeds").then(filterPublished),
]);

const allPosts = await getAllPosts();
---

<Layout
    title="The Greenhouse"
    description={PAGE_DESCRIPTIONS.home}
    canonicalPath="/"
>
    <div class="max-w-5xl mx-auto px-6 md:px-10 py-16">
        <section class="mb-12">
            <h1 class="text-4xl tracking-tight mb-3">The Greenhouse.</h1>
            <p class="text-lg text-foreground-muted max-w-xl">
                Digital Garden. Growing thoughts.
            </p>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-16">
            <div class="animate-entrance" style="--delay: 0ms">
                <SectionCard
                    name="Flora"
                    description="Blooming thoughts, flowering essays"
                    count={allFlora.length}
                    href="/flora/"
                >
                    <svg
                        slot="icon"
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><circle cx="12" cy="8" r="2.5"/><circle cx="7.5" cy="11" r="2.5"/><circle cx="9.5" cy="16" r="2.5"/><circle cx="14.5" cy="16" r="2.5"/><circle cx="16.5" cy="11" r="2.5"/><circle cx="12" cy="12" r="2" fill="currentColor"/><line x1="12" y1="14" x2="12" y2="22"/></svg
                    >
                </SectionCard>
            </div>
            <div class="animate-entrance" style="--delay: 100ms">
                <SectionCard
                    name="Nursery"
                    description="Growing ideas, evergreen notes"
                    count={allNursery.length}
                    href="/nursery/"
                >
                    <svg
                        slot="icon"
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M7 21h10M12 21V11"></path><path d="M12 11C9 11 6 8.5 6 5c2 0 4.5 1 6 6 1.5-5 4-6 6-6 0 3.5-3 6-6 6z"></path></svg
                    >
                </SectionCard>
            </div>
            <div class="animate-entrance" style="--delay: 200ms">
                <SectionCard
                    name="Seeds"
                    description="Seeds of thought, one line at a time"
                    count={allSeeds.length}
                    href="/seeds/"
                    variant="earth"
                >
                    <svg
                        slot="icon"
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M12 4C8 8 7 12 7 15a5 5 0 0 0 10 0c0-3-1-7-5-11z"/><path d="M12 12v6"/><path d="M10 15c1-1 2-2 2-3"/></svg
                    >
                </SectionCard>
            </div>
        </section>

        <section>
            <h2
                class="text-xs font-medium uppercase tracking-widest text-foreground-muted mb-8"
            >
                Latest
            </h2>
            <div class="flex flex-col gap-4">
                {
                    allPosts.slice(0, 10).map((post) => (
                        <a
                            href={post.url}
                            class="flex items-baseline justify-between gap-4 group"
                        >
                            <div class="flex items-baseline gap-3 min-w-0">
                                <span
                                    class:list={[
                                        "text-xs shrink-0",
                                        SECTION_INDEX_CONFIG[post.section]
                                            .accentClass,
                                    ]}
                                >
                                    {post.section.charAt(0).toUpperCase() + post.section.slice(1)}
                                </span>
                                <span class="text-base font-medium text-foreground group-hover:text-accent transition-colors truncate">
                                    {post.data.title}
                                </span>
                            </div>
                            <span class="text-xs text-foreground-muted font-mono shrink-0">
                                {post.data.date.toISOString().split("T")[0]}
                            </span>
                        </a>
                    ))
                }
            </div>
        </section>
    </div>
</Layout>
<style>
    .animate-entrance {
        opacity: 0;
        transform: translateY(1rem);
        animation: fade-slide-in 0.5s ease-out forwards;
        animation-delay: var(--delay, 0ms);
    }
</style>
