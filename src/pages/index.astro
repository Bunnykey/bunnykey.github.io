---
import JournalLayout from '../layouts/JournalLayout.astro';
import {getAllPosts} from '../utils/posts';
// A curated opening page; the other posts and their URLs remain intact.
const posts=await getAllPosts();
const featured=posts.find(post=>post.section==='nursery' && post.slug==='clearance-sale');
---
<JournalLayout title="글 모음">
<section class="reading-page home-index" aria-labelledby="index-title">
<h1 id="index-title">글 모음</h1>
{featured ? <article>
<p class="reading-meta"><time datetime={featured.data.date.toISOString()}>{featured.data.date.toISOString().slice(0,10).replaceAll('-','. ')}</time></p>
<h2><a href={featured.url}>{featured.data.title}</a></h2>
{featured.data.summary && <p class="reading-summary">{featured.data.summary}</p>}
<a class="read-link" href={featured.url}>읽기 →</a>
</article> : <p>아직 공개된 글이 없습니다.</p>}
</section>
</JournalLayout>
<style>
.home-index{min-height:50vh}.home-index h1{font-size:14px;font-weight:400;color:var(--journal-muted);margin:0 0 48px}.home-index h2{font:600 clamp(30px,5vw,42px)/1.4 var(--journal-body);margin:0 0 24px}.home-index h2 a{text-decoration:none}.home-index h2 a:hover{text-decoration:underline;text-underline-offset:8px;text-decoration-thickness:1px}.read-link{font-size:14px;text-underline-offset:5px}
</style>
