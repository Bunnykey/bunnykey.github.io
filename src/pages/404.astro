---
import Layout from '../layouts/Layout.astro';
import { TOPICS } from '../consts/topics';
---
<Layout title="찾을 수 없음 | The Greenhouse"><main class="not-found"><p>THE GREENHOUSE / 404</p><h1>길을<br />잃었어요.</h1><p>찾으시는 페이지는 없거나 다른 곳으로 옮겨졌습니다.</p><a href="/">홈으로 돌아가기 →</a><nav>{Object.entries(TOPICS).map(([key, topic]) => <a href={`/topics/${key}/`}>{topic.label}</a>)}</nav></main></Layout>
<style>.not-found { width: min(100% - 2.5rem, 48rem); margin: 0 auto; padding: 10rem 0; }.not-found > p:first-child { font-size: .66rem; font-weight: 700; letter-spacing: .14em; color: var(--color-foreground-muted); }.not-found h1 { margin: 1rem 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(5rem, 14vw, 9rem); font-weight: 400; line-height: .78; letter-spacing: -.1em; }.not-found > p:nth-of-type(2) { margin-top: 2rem; color: var(--color-foreground-muted); }.not-found > a { display: inline-block; margin-top: 1.5rem; padding-bottom: .2rem; border-bottom: 1px solid var(--color-foreground); font-size: .8rem; font-weight: 700; }.not-found nav { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 5rem; padding-top: 1rem; border-top: 1px solid var(--color-outline-subtle); }.not-found nav a { font-size: .72rem; color: var(--color-foreground-muted); }</style>
