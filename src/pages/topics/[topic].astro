---
import Layout from '../../layouts/Layout.astro';
import JournalList from '../../components/JournalList.astro';
import { TOPICS, topicFor, type TopicKey } from '../../consts/topics';
import { getAllPosts } from '../../utils/posts';
export function getStaticPaths() { return Object.keys(TOPICS).map(topic => ({ params: { topic } })); }
const topicKey = Astro.params.topic as TopicKey;
const topic = TOPICS[topicKey];
const posts = (await getAllPosts()).filter(post => topicFor(post.data.category) === topicKey);
---
<Layout title={`${topic.label} | The Greenhouse`} description={topic.description} canonicalPath={`/topics/${topicKey}/`}>
  <JournalList posts={posts} topic={topicKey} />
</Layout>
