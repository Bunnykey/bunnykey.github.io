---
import Layout from '../../layouts/Layout.astro';
import { TOPICS, topicFor, type TopicKey } from '../../consts/topics';
import { getAllPosts } from '../../utils/posts';

export function getStaticPaths() { return Object.keys(TOPICS).map((topic) => ({ params: { topic } })); }
const topicKey = Astro.params.topic as TopicKey;
const topic = TOPICS[topicKey];
const posts = (await getAllPosts()).filter((post) => topicFor(post.data.category) === topicKey);
---

<Layout title={`${topic.label} | The Greenhouse`} description={topic.description} canonicalPath={`/topics/${topicKey}/`}>
  <main class="journal-list-page">
    <header class="list-masthead"><p>THE GREENHOUSE / {topicKey.toUpperCase()}</p><h1>{topic.label}</h1><p>{topic.description}</p></header>
    <nav class="list-topic-nav" aria-label="글 주제">{Object.entries(TOPICS).map(([key, item]) => <a href={`/topics/${key}/`} aria-current={key === topicKey ? 'page' : undefined}>{item.label}</a>)}</nav>
    <section class="editorial-list" aria-label={`${topic.label} 글 목록`}>
      <div class="list-label"><span>{posts.length} POSTS</span><span>SELECTED WRITING</span></div>
      {posts.length ? posts.map((post, index) => <article class="editorial-row"><span class="row-index">0{index + 1}</span><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time><div><h2><a href={post.url}>{post.data.title}</a></h2>{post.data.summary && <p>{post.data.summary}</p>}</div><a href={post.url} class="row-arrow" aria-label={`${post.data.title} 읽기`}>↗</a></article>) : <div class="list-empty"><p>아직 이 주제의 글이 없습니다.</p><a href="/editor/">첫 글 쓰기 →</a></div>}
    </section>
  </main>
</Layout>

<style>
  .journal-list-page { width: min(100% - 2.5rem, 64rem); margin: 0 auto; padding: 4.5rem 0 7rem; } .list-masthead { max-width: 44rem; padding: 1rem 0 3.5rem; } .list-masthead p { font-size: .68rem; font-weight: 700; letter-spacing: .14em; color: var(--color-foreground-muted); } .list-masthead h1 { margin: .8rem 0 1rem; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(4rem, 11vw, 7.5rem); font-weight: 400; letter-spacing: -.09em; line-height: .88; } .list-masthead p:last-child { font-size: .95rem; font-weight: 400; letter-spacing: 0; line-height: 1.7; }
  .list-topic-nav { display: flex; gap: 1.5rem; padding: .85rem 0; border-top: 1px solid var(--color-outline-subtle); border-bottom: 1px solid var(--color-outline-subtle); overflow-x: auto; } .list-topic-nav a { flex: none; font-size: .7rem; font-weight: 700; letter-spacing: .08em; color: var(--color-foreground-muted); } .list-topic-nav a[aria-current='page'] { color: var(--color-foreground); text-decoration: underline; text-underline-offset: .35rem; }
  .editorial-list { margin-top: 3rem; } .list-label { display: flex; justify-content: space-between; padding-bottom: .9rem; color: var(--color-foreground-muted); font-size: .64rem; font-weight: 700; letter-spacing: .13em; } .editorial-row { display: grid; grid-template-columns: 2.5rem 6rem minmax(0, 1fr) 1.5rem; gap: 1rem; align-items: start; padding: 2rem 0; border-top: 1px solid var(--color-outline-subtle); transition: padding .25s ease; } .editorial-row:hover { padding-left: .65rem; } .row-index, .editorial-row time { padding-top: .4rem; font-family: monospace; font-size: .7rem; color: var(--color-foreground-muted); } .editorial-row h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.65rem, 3vw, 2.55rem); font-weight: 400; letter-spacing: -.05em; line-height: 1.1; } .editorial-row p { margin-top: .6rem; color: var(--color-foreground-muted); font-size: .88rem; line-height: 1.7; } .row-arrow { font-size: 1.2rem; transition: transform .2s ease; } .editorial-row:hover .row-arrow { transform: translate(.2rem, -.2rem); } .list-empty { padding: 5rem 0; border-top: 1px solid var(--color-outline-subtle); color: var(--color-foreground-muted); } .list-empty a { display: inline-block; margin-top: 1rem; color: var(--color-foreground); font-size: .8rem; font-weight: 700; }
  @media (max-width: 640px) { .journal-list-page { width: min(100% - 2rem, 64rem); padding-top: 2rem; } .editorial-row { grid-template-columns: 2rem 1fr 1.2rem; gap: .7rem; } .editorial-row time { display: none; } }
</style>
