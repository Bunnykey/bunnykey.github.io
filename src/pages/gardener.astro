---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm";
import { PAGE_DESCRIPTIONS } from "../consts/site";
---

<Layout
    title="The Gardener - The Greenhouse"
    description={PAGE_DESCRIPTIONS.gardener}
    canonicalPath="/gardener/"
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            name: "Bunnykey",
            url: "https://bunnykey.github.io/gardener/",
            jobTitle: "Software PM",
            sameAs: ["https://github.com/bunnykey"],
        })}
    />
    <div class="max-w-5xl mx-auto px-6 md:px-10 py-16">
        <!-- Profile -->
        <section class="mb-16 max-w-xl">
            <span
                class="inline-block text-xs font-medium tracking-widest text-foreground-muted uppercase mb-6 px-3 py-1 bg-surface-raised rounded"
            >
                THE GARDENER
            </span>
            <h1 class="text-3xl tracking-tight mb-6">
                Bunnykey (Hwanwoong Yong)
            </h1>
            <div
                class="space-y-4 text-base text-foreground-muted leading-relaxed"
            >
                <p>Junior SW PM.</p>
                <p>
                    This archive is personal and does not reflect the views of
                    my employer.
                </p>
            </div>
            <div class="flex gap-6 mt-6">
                <a
                    href="https://github.com/bunnykey"
                    target="_blank"
                    class="text-sm text-accent hover:text-accent/80 transition-colors"
                >
                    GitHub ↗
                </a>
                <a
                    href="mailto:sapphire7558@gmail.com"
                    class="text-sm text-accent hover:text-accent/80 transition-colors"
                >
                    Email ↗
                </a>
            </div>
        </section>

        <!-- Contact -->
        <section class="bg-surface-raised rounded-xl p-8 md:p-10">
            <div
                class="flex flex-col md:flex-row gap-10 max-w-xl md:max-w-none"
            >
                <div class="flex-1">
                    <h2 class="text-2xl tracking-tight mb-3">Plant a seed.</h2>
                    <p class="text-sm text-foreground-muted leading-relaxed">
                        협업, 질문, 또는 인사 — 의미 있는 대화에 언제나 열려
                        있습니다.
                    </p>
                </div>
                <div class="flex-1">
                    <ContactForm client:visible />
                </div>
            </div>
        </section>
    </div>
</Layout>
