---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { SITE, toCanonicalUrl } from '../consts/site';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleDate?: string;
}

const {
  title,
  description = SITE.defaultDescription,
  canonicalPath = Astro.url.pathname,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  ogType = 'website',
  articleDate,
} = Astro.props;
const canonicalUrl = toCanonicalUrl(canonicalPath);
const currentPath = Astro.url.pathname;
const inferredOgImage =
  currentPath.match(/^\/(flora|nursery|seeds)\/[^/]+\/$/)
    ? `${currentPath.replace(/\/$/, '')}.png`.replace(/^\/(flora|nursery|seeds)\//, '/og/$1/')
    : undefined;
const resolvedOgImage = ogImage || inferredOgImage || SITE.defaultOgImage;
const ogImageUrl = resolvedOgImage.startsWith('http')
  ? resolvedOgImage
  : `${SITE.siteUrl}${resolvedOgImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function() {
        const themes = {
          garden: { style: 'garden', atmosphere: 'sunny', brightness: 'light' },
          rain: { style: 'garden', atmosphere: 'rain', brightness: 'light' },
          moonlight: { style: 'twilight', atmosphere: 'moonlight', brightness: 'dark' },
          dawn: { style: 'terracotta', atmosphere: 'dawn', brightness: 'light' },
          aurora: { style: 'twilight', atmosphere: 'aurora', brightness: 'dark' },
        };
        const legacyAtmo = localStorage.getItem('atmosphere');
        const fallback = legacyAtmo === 'rain' || legacyAtmo === 'moonlight' || legacyAtmo === 'dawn' || legacyAtmo === 'aurora'
          ? legacyAtmo
          : localStorage.getItem('style') === 'twilight' ? 'moonlight' : 'garden';
        const selected = themes[localStorage.getItem('visualTheme')] ? localStorage.getItem('visualTheme') : fallback;
        const config = themes[selected];
        document.documentElement.dataset.style = config.style;
        document.documentElement.dataset.atmosphere = config.atmosphere;
        document.documentElement.dataset.theme = config.brightness;
        document.documentElement.style.colorScheme = config.brightness;
        const meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', config.brightness === 'dark' ? '#10141d' : '#faf9f6');
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" id="meta-theme-color" content="#faf9f6" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io;" />
    <title>{title}</title>
    <ViewTransitions />
    {ogType === 'article' && articleDate ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": ogTitle,
        "datePublished": articleDate,
        "author": { "@type": "Person", "name": "Bunnykey", "url": `${SITE.siteUrl}/gardener/` },
        "description": ogDescription,
        "image": ogImageUrl,
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": SITE.name,
        "url": SITE.siteUrl,
      })} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <video
      id="atmosphere-video"
      class="atmosphere-video"
      muted
      playsinline
      loop
      aria-hidden="true"
    ></video>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navbar transition:persist />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
